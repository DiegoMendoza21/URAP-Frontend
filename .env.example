# Copie este archivo como .env.local y ajuste los valores. Los .env* nunca van al repositorio,
# salvo esta plantilla.

# URL base de la API del backend (URAP-Backend), con el prefijo /api y sin barra final.
# Next.js la incrusta en el código del navegador al compilar: si la cambia, reinicie
# `npm run dev` o vuelva a ejecutar `npm run build`.
NEXT_PUBLIC_URL_API=http://localhost:3001/api
