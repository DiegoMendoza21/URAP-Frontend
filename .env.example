# Copie este archivo como .env.local y ajuste los valores. Los .env* nunca van al repositorio,
# salvo esta plantilla.

# URL base de la API del backend (URAP-Backend), con el prefijo /api y sin barra final.
# Solo la usa el servidor de Next: el navegador llama a /api en este mismo origen, y Next
# reenvía cada petición al backend con el token de la sesión, que guarda en una cookie
# httpOnly. Sin esta variable, `npm run dev` y `npm run start` no arrancan.
URL_API=http://localhost:3001/api
