{
  "name": "urap-frontend",
  "version": "0.0.1",
  "description": "Interfaz de URAP: seguimiento, control y análisis de los proyectos docentes (Universidad de Cartagena)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "format": "prettier --write src next.config.ts eslint.config.mjs",
    "tipos:generar": "openapi-typescript http://localhost:3001/api/openapi.json --output src/api/openapi.d.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
